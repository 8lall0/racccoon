module user;

import std::nolibc::mem;

// wpatest — the WPA2 supplicant (user/usb/rtl_wpa.c3) against a real
// capture: the four EAPOL-Key frames of Wireshark's wpa-Induction.pcap
// (SSID "Coherer", passphrase "Induction", AP 00:0c:41:82:b2:55, station
// 00:0d:93:82:36:3a). The chip side is stubbed: register writes are
// counted, the frames the supplicant sends are captured here. Checks:
//   1. PBKDF2 gives the published PMK;
//   2. message 1 -> our message 2 (structure + its MIC);
//   3. with the capture's SNonce, the derived PTK verifies the real
//      station's message 2 MIC and message 4 MIC;
//   4. message 3 -> MIC ok, GTK unwrapped, our message 4 matches the
//      capture's (bar the key-length field), keys go into the CAM;
//   5. a wrong passphrase is caught as a message 3 MIC mismatch.

// --- stubs for what rtl8192eu.c3 provides inside usbd -------------------
char[6] g_rtl_mac;
char[6] g_sta_bssid;
bool g_sta_secure;
uint g_wt_reg_writes;
uint g_wt_secured;
char[512] g_wt_sent;
uint g_wt_sent_len;
uint g_wt_sent_count;
uint g_wt_sent_etype;

fn void rtl_w32(uint a, uint v) { g_wt_reg_writes++; }
fn void rtl_w16(uint a, uint v) { g_wt_reg_writes++; }
fn void rtl_w8(uint a, uint v)  { g_wt_reg_writes++; }
fn uint rtl_r16(uint a) { return 0; }
fn void rtl_udelay(ulong us) { }
fn void rtl_sta_secured() { g_wt_secured++; }
fn bool rtl_send_data(char* da, char* sa, uint etype, char* payload, uint plen)
{
	if (plen > 512) { plen = 512; }
	mem::copy(&g_wt_sent[0], payload, (sz)plen);
	g_wt_sent_len = plen;
	g_wt_sent_etype = etype;
	g_wt_sent_count++;
	return true;
}

const char[121] WT_MSG1 = { 0x02, 0x03, 0x00, 0x75, 0x02, 0x00, 0x8a, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x3e, 0x8e, 0x96, 0x7d, 0xac, 0xd9, 0x60, 0x32, 0x4c, 0xac, 0x5b, 0x6a, 0xa7, 0x21, 0x23, 0x5b, 0xf5, 0x7b, 0x94, 0x97, 0x71, 0xc8, 0x67, 0x98, 0x9f, 0x49, 0xd0, 0x4e, 0xd4, 0x7c, 0x69, 0x33, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0xdd, 0x14, 0x00, 0x0f, 0xac, 0x04, 0x59, 0x2d, 0xa8, 0x80, 0x96, 0xc4, 0x61, 0xda, 0x24, 0x6c, 0x69, 0x00, 0x1e, 0x87, 0x7f, 0x3d };
const char[121] WT_MSG2 = { 0x02, 0x03, 0x00, 0x75, 0x02, 0x01, 0x0a, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xcd, 0xf4, 0x05, 0xce, 0xb9, 0xd8, 0x89, 0xef, 0x3d, 0xec, 0x42, 0x60, 0x98, 0x28, 0xfa, 0xe5, 0x46, 0xb7, 0xad, 0xd7, 0xba, 0xec, 0xbb, 0x1a, 0x39, 0x4e, 0xac, 0x52, 0x14, 0xb1, 0xd3, 0x86, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xa4, 0x62, 0xa7, 0x02, 0x9a, 0xd5, 0xba, 0x30, 0xb6, 0xaf, 0x0d, 0xf3, 0x91, 0x98, 0x8e, 0x45, 0x00, 0x16, 0x30, 0x14, 0x01, 0x00, 0x00, 0x0f, 0xac, 0x02, 0x01, 0x00, 0x00, 0x0f, 0xac, 0x04, 0x01, 0x00, 0x00, 0x0f, 0xac, 0x02, 0x00, 0x00 };
const char[179] WT_MSG3 = { 0x02, 0x03, 0x00, 0xaf, 0x02, 0x13, 0xca, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x3e, 0x8e, 0x96, 0x7d, 0xac, 0xd9, 0x60, 0x32, 0x4c, 0xac, 0x5b, 0x6a, 0xa7, 0x21, 0x23, 0x5b, 0xf5, 0x7b, 0x94, 0x97, 0x71, 0xc8, 0x67, 0x98, 0x9f, 0x49, 0xd0, 0x4e, 0xd4, 0x7c, 0x69, 0x33, 0xf5, 0x7b, 0x94, 0x97, 0x71, 0xc8, 0x67, 0x98, 0x9f, 0x49, 0xd0, 0x4e, 0xd4, 0x7c, 0x69, 0x34, 0xcf, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x7d, 0x0a, 0xf6, 0xdf, 0x51, 0xe9, 0x9c, 0xde, 0x7a, 0x18, 0x74, 0x53, 0xf0, 0xf9, 0x35, 0x37, 0x00, 0x50, 0xcf, 0xa7, 0x2c, 0xde, 0x35, 0xb2, 0xc1, 0xe2, 0x31, 0x92, 0x55, 0x80, 0x6a, 0xb3, 0x64, 0x17, 0x9f, 0xd9, 0x67, 0x30, 0x41, 0xb9, 0xa5, 0x93, 0x9f, 0xa1, 0xa2, 0x01, 0x0d, 0x2a, 0xc7, 0x94, 0xe2, 0x51, 0x68, 0x05, 0x5f, 0x79, 0x4d, 0xdc, 0x1f, 0xdf, 0xae, 0x35, 0x21, 0xf4, 0x44, 0x6b, 0xfd, 0x11, 0xda, 0x98, 0x34, 0x5f, 0x54, 0x3d, 0xf6, 0xce, 0x19, 0x9d, 0xf8, 0xfe, 0x48, 0xf8, 0xcd, 0xd1, 0x7a, 0xdc, 0xa8, 0x7b, 0xf4, 0x57, 0x11, 0x18, 0x3c, 0x49, 0x6d, 0x41, 0xaa, 0x0c };
const char[99] WT_MSG4 = { 0x02, 0x03, 0x00, 0x5f, 0x02, 0x03, 0x0a, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0xbb, 0xa3, 0xbd, 0xfb, 0xcf, 0xde, 0x2b, 0xc5, 0x37, 0x50, 0x9d, 0x71, 0xf2, 0xec, 0xd1, 0x00, 0x00 };

const char[32] WT_PMK = { 0xa2, 0x88, 0xfc, 0xf0, 0xca, 0xaa, 0xcd, 0xa9, 0xa9, 0xf5, 0x86, 0x33, 0xff, 0x35, 0xe8, 0x99,
	0x2a, 0x01, 0xd9, 0xc1, 0x0b, 0xa5, 0xe0, 0x2e, 0xfd, 0xf8, 0xcb, 0x5d, 0x73, 0x0c, 0xe7, 0xbc };

int g_wt_fail;

fn void check(bool ok, char* what)
{
	print(ok ? "  ok   " : "  FAIL ");
	print(what);
	print("\n");
	if (!ok) { g_wt_fail++; }
}

fn bool same(char* a, char* b, uint n)
{
	for (uint i = 0; i < n; i++) { if (a[i] != b[i]) { return false; } }
	return true;
}

fn void wt_setup(char* pass)
{
	char[6] sta = { 0x00, 0x0d, 0x93, 0x82, 0x36, 0x3a };
	char[6] ap  = { 0x00, 0x0c, 0x41, 0x82, 0xb2, 0x55 };
	mem::copy(&g_rtl_mac[0], &sta[0], 6);
	mem::copy(&g_sta_bssid[0], &ap[0], 6);
	g_sta_secure = true;
	uint pl = 0;
	while (pass[pl] != 0) { pl++; }
	pbkdf2_sha1(pass, pl, "Coherer", 7, 4096, &g_wpa_pmk[0], 32);
	g_wpa_have_pmk = true;
	wpa_reset();
	g_wt_sent_count = 0;
	g_wt_secured = 0;
	g_wpa_mic_fail = 0;
}

fn void wt_feed(char* frame, uint len)
{
	char[256] buf;
	mem::copy(&buf[0], frame, (sz)len);
	wpa_eapol_rx(&buf[0], len);
}

fn int main()
{
	print("wpatest: WPA2 4-way handshake vs wpa-Induction.pcap\n");
	wt_setup("Induction");
	check(same(&g_wpa_pmk[0], &WT_PMK[0], 32), "PBKDF2 PMK");

	wt_feed(&WT_MSG1[0], WT_MSG1.len);
	check(g_wt_sent_count == 1 && g_wt_sent_etype == 0x888E, "message 1 -> one EAPOL frame sent");
	char* m2 = &g_wt_sent[0];
	check(g_wt_sent_len == 99 + 22 && be16(&m2[5]) == 0x010A, "our message 2: key info 0x010a + RSN IE");
	check(same(&m2[4 + 5], &WT_MSG1[4 + 5], 8), "our message 2: replay counter echoed");
	check(same(&m2[4 + 13], &g_wpa_snonce[0], 32), "our message 2: carries our SNonce");
	check(same(&m2[4 + 95], &WPA_RSN_IE[0], 22), "our message 2: key data = our RSN IE");
	check(wpa_mic_ok(m2, g_wt_sent_len), "our message 2: MIC verifies");

	// the real station's nonce -> the real PTK
	mem::copy(&g_wpa_snonce[0], &WT_MSG2[4 + 13], 32);
	wpa_derive_ptk();
	check(wpa_mic_ok(&WT_MSG2[0], WT_MSG2.len), "PTK verifies the captured message 2 MIC");
	check(wpa_mic_ok(&WT_MSG4[0], WT_MSG4.len), "PTK verifies the captured message 4 MIC");

	g_wt_sent_count = 0;
	uint w0 = g_wt_reg_writes;
	wt_feed(&WT_MSG3[0], WT_MSG3.len);
	check(g_wpa_mic_fail == 0, "message 3 MIC ok");
	check(g_wt_sent_count == 1 && g_wt_sent_len == WT_MSG4.len, "message 3 -> message 4 sent");
	char* m4 = &g_wt_sent[0];
	bool m4ok = true;
	for (uint i = 0; i < WT_MSG4.len; i++)
	{
		if (i == 4 + 3 || i == 4 + 4) { continue; }              // key length: we send 0 (RSN), the capture 16
		if (i >= 4 + 77 && i < 4 + 93) { continue; }             // MIC (covers the key length)
		if (m4[i] != WT_MSG4[i]) { m4ok = false; }
	}
	check(m4ok, "our message 4 = the captured one (bar key length + MIC)");
	check(wpa_mic_ok(m4, g_wt_sent_len), "our message 4: MIC verifies");
	check(g_wpa_keyed && g_wt_secured == 1, "keys installed, station secured");
	check(g_wt_reg_writes - w0 >= 2 * 12, "pairwise + group key written to the CAM");
	check(g_wpa_gtk_idx >= 1 && g_wpa_gtk_idx <= 3, "GTK key id 1..3");

	wt_setup("NotTheOne");
	wt_feed(&WT_MSG1[0], WT_MSG1.len);
	wt_feed(&WT_MSG3[0], WT_MSG3.len);
	check(g_wpa_mic_fail == 1 && !g_wpa_keyed, "wrong passphrase: message 3 MIC mismatch, no keys");

	print(g_wt_fail == 0 ? "wpatest: ok\n" : "wpatest: FAILED\n");
	exitcode(g_wt_fail == 0 ? 0 : 1);
	return 0;
}
