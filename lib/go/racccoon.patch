diff --git a/src/syscall/fs_racccoon.go b/src/syscall/fs_racccoon.go
new file mode 100644
index 00000000..544af83b
--- /dev/null
+++ b/src/syscall/fs_racccoon.go
@@ -0,0 +1,183 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build tamago
+
+// When runtime/goos.FS is set (by a GOOSPKG provider — the racccoon
+// tree's go/racccoon package), every path-based filesystem syscall
+// below routes to that host backend instead of fs_tamago.go's in-memory
+// filesystem. nil FS keeps the in-memory behaviour unchanged. See
+// docs/go-port-plan.md in the racccoon tree.
+
+package syscall
+
+import "runtime/goos"
+
+// goosFile is the fileImpl for an fd opened through goos.FS.
+type goosFile struct {
+	defaultFileImpl
+	h     uintptr
+	off   int64
+	isDir bool
+	// directory listing, fetched from the backend on first readDirent
+	dents  []string
+	dentsD []bool
+	dpos   int
+}
+
+// goosErr maps a backend error onto a syscall.Errno so package os's
+// IsNotExist / IsPermission mostly work. racccoon's fsd protocol only
+// carries a bare failure, so an unclassified error becomes ENOENT (the
+// common case) unless the backend already returned an Errno.
+func goosErr(err error) error {
+	if err == nil {
+		return nil
+	}
+	if e, ok := err.(Errno); ok {
+		return e
+	}
+	return ENOENT
+}
+
+func goosFillStat(st *Stat_t, size int64, isDir bool) {
+	*st = Stat_t{Size: size, Nlink: 1}
+	if isDir {
+		st.Mode = S_IFDIR | 0755
+	} else {
+		st.Mode = S_IFREG | 0644
+	}
+}
+
+func goosOpen(path string, openmode int, perm uint32) (int, error) {
+	h, isDir, size, err := goos.FS.Open(path, openmode, perm)
+	if err != nil {
+		return -1, goosErr(err)
+	}
+	f := &goosFile{h: h, isDir: isDir}
+	if openmode&O_APPEND != 0 {
+		f.off = size
+	}
+	return newFD(f), nil
+}
+
+func goosStat(path string, st *Stat_t) error {
+	size, isDir, err := goos.FS.Stat(path)
+	if err != nil {
+		return goosErr(err)
+	}
+	goosFillStat(st, size, isDir)
+	return nil
+}
+
+func fdToGoosFile(fd int) (*goosFile, bool) {
+	f, err := fdToFile(fd)
+	if err != nil {
+		return nil, false
+	}
+	gf, ok := f.impl.(*goosFile)
+	return gf, ok
+}
+
+func (f *goosFile) stat(st *Stat_t) error {
+	size, isDir, err := goos.FS.Fstat(f.h)
+	if err != nil {
+		return goosErr(err)
+	}
+	goosFillStat(st, size, isDir)
+	return nil
+}
+
+func (f *goosFile) read(b []byte) (int, error) {
+	if f.isDir {
+		return 0, EISDIR
+	}
+	n, err := goos.FS.Pread(f.h, b, f.off)
+	f.off += int64(n)
+	if err != nil {
+		return n, goosErr(err)
+	}
+	return n, nil
+}
+
+func (f *goosFile) pread(b []byte, off int64) (int, error) {
+	n, err := goos.FS.Pread(f.h, b, off)
+	if err != nil {
+		return n, goosErr(err)
+	}
+	return n, nil
+}
+
+func (f *goosFile) write(b []byte) (int, error) {
+	n, err := goos.FS.Pwrite(f.h, b, f.off)
+	f.off += int64(n)
+	if err != nil {
+		return n, goosErr(err)
+	}
+	return n, nil
+}
+
+func (f *goosFile) pwrite(b []byte, off int64) (int, error) {
+	n, err := goos.FS.Pwrite(f.h, b, off)
+	if err != nil {
+		return n, goosErr(err)
+	}
+	return n, nil
+}
+
+func (f *goosFile) seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case 1:
+		offset += f.off
+	case 2:
+		size, _, err := goos.FS.Fstat(f.h)
+		if err != nil {
+			return 0, goosErr(err)
+		}
+		offset += size
+	}
+	if offset < 0 {
+		return 0, EINVAL
+	}
+	f.off = offset
+	return offset, nil
+}
+
+func (f *goosFile) close() error {
+	return goosErr(goos.FS.Close(f.h))
+}
+
+func goosPutDirent(rec []byte, ino int64, name string) {
+	for i := 0; i < direntSize; i++ {
+		rec[i] = 0
+	}
+	u := uint64(ino)
+	for i := 0; i < 8; i++ {
+		rec[i] = byte(u >> (8 * i))
+	}
+	// rec[8:16] = Off — package os ignores it here
+	rec[16] = byte(direntSize & 0xff)
+	rec[17] = byte((direntSize >> 8) & 0xff)
+	copy(rec[18:direntSize], name)
+}
+
+func (f *goosFile) readDirent(buf []byte) (int, error) {
+	if f.dents == nil {
+		names, isDir, err := goos.FS.Dirents(f.h)
+		if err != nil {
+			return 0, goosErr(err)
+		}
+		if names == nil {
+			names = []string{}
+		}
+		f.dents, f.dentsD = names, isDir
+	}
+	n := 0
+	for f.dpos < len(f.dents) && len(buf) >= direntSize {
+		goosPutDirent(buf[:direntSize], int64(f.dpos+1), f.dents[f.dpos])
+		buf = buf[direntSize:]
+		n += direntSize
+		f.dpos++
+	}
+	return n, nil
+}
