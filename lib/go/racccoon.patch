+		return goosErr(goos.FS.Remove(path, isdir))
+	}
 	fsinit()
 	fs.mu.Lock()
 	defer fs.mu.Unlock()
@@ -723,6 +748,9 @@ func (fs *fsys) subtreeContains(dir, p *inode) bool {
 }
 
