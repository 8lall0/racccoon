diff --git a/src/syscall/fsgoos_racccoon.go b/src/syscall/fsgoos_racccoon.go
new file mode 100644
index 00000000..7d65df14
--- /dev/null
+++ b/src/syscall/fsgoos_racccoon.go
@@ -0,0 +1,278 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build racccoon
+
+// When runtime/goos.FS is set (racccoon_fs.go's init installs it for
+// GOARCH=riscv64), every path-based filesystem syscall below routes to
+// that host backend instead of fs_racccoon.go's in-memory filesystem.
+// nil FS keeps the in-memory behaviour unchanged. See docs/go-port-plan.md
+// in the racccoon tree.
+
+package syscall
+
+import "runtime/goos"
+
+// goosErrno maps a backend errno onto a syscall.Errno.
+func goosErrno(e int) error {
+	switch e {
+	case 0:
+		return nil
+	case 2:
+		return ENOENT
+	case 9:
+		return EBADF
+	case 17:
+		return EEXIST
+	case 38:
+		return ENOSYS
+	default:
+		return EIO
+	}
+}
+
+func goosFillStat(st *Stat_t, size int64, isDir bool) {
+	*st = Stat_t{Size: size, Nlink: 1}
+	if isDir {
+		st.Mode = S_IFDIR | 0755
+	} else {
+		// 0755, not 0644: racccoon's fsd exposes no per-file exec
+		// permission (exec() runs any readable file), and `go build`'s
+		// pathcache.LookPath rejects a tool binary whose mode has no
+		// execute bit ("executable file not found").
+		st.Mode = S_IFREG | 0755
+	}
+}
+
+// goosFile is the fileImpl for an fd opened through goos.FS.
+type goosFile struct {
+	defaultFileImpl
+	h     uintptr
+	path  string // kept for fd-based ops the backend only does by path (Ftruncate)
+	off   int64
+	isDir bool
+	dents  []string
+	dentsD []bool
+	dpos   int
+}
+
+// ftruncate: the backend has no truncate-by-handle, so resize by path.
+func (f *goosFile) ftruncate(length int64) error {
+	if f.path == "" {
+		return EINVAL
+	}
+	return goosErrno(goos.FS.Truncate(f.path, length))
+}
+
+func goosOpen(path string, openmode int, perm uint32) (int, error) {
+	h, isDir, size, e := goos.FS.Open(path, openmode, perm)
+	if e != 0 {
+		return -1, goosErrno(e)
+	}
+	f := &goosFile{h: h, path: path, isDir: isDir}
+	if openmode&O_APPEND != 0 {
+		f.off = size
+	}
+	return newFD(f), nil
+}
+
+func goosStat(path string, st *Stat_t) error {
+	size, isDir, e := goos.FS.Stat(path)
+	if e != 0 {
+		return goosErrno(e)
+	}
+	goosFillStat(st, size, isDir)
+	return nil
+}
+
+func fdToGoosFile(fd int) (*goosFile, bool) {
+	f, err := fdToFile(fd)
+	if err != nil {
+		return nil, false
+	}
+	gf, ok := f.impl.(*goosFile)
+	return gf, ok
+}
+
+func (f *goosFile) stat(st *Stat_t) error {
+	size, isDir, e := goos.FS.Fstat(f.h)
+	if e != 0 {
+		return goosErrno(e)
+	}
+	goosFillStat(st, size, isDir)
+	return nil
+}
+
+func (f *goosFile) read(b []byte) (int, error) {
+	if f.isDir {
+		return 0, EISDIR
+	}
+	n, e := goos.FS.Pread(f.h, b, f.off)
+	f.off += int64(n)
+	if e != 0 {
+		return n, goosErrno(e)
+	}
+	return n, nil
+}
+
+func (f *goosFile) pread(b []byte, off int64) (int, error) {
+	n, e := goos.FS.Pread(f.h, b, off)
+	if e != 0 {
+		return n, goosErrno(e)
+	}
+	return n, nil
+}
+
+func (f *goosFile) write(b []byte) (int, error) {
+	n, e := goos.FS.Pwrite(f.h, b, f.off)
+	f.off += int64(n)
+	if e != 0 {
+		return n, goosErrno(e)
+	}
+	return n, nil
+}
+
+func (f *goosFile) pwrite(b []byte, off int64) (int, error) {
+	n, e := goos.FS.Pwrite(f.h, b, off)
+	if e != 0 {
+		return n, goosErrno(e)
+	}
+	return n, nil
+}
+
+func (f *goosFile) seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case 1:
+		offset += f.off
+	case 2:
+		size, _, e := goos.FS.Fstat(f.h)
+		if e != 0 {
+			return 0, goosErrno(e)
+		}
+		offset += size
+	}
+	if offset < 0 {
+		return 0, EINVAL
+	}
+	f.off = offset
+	return offset, nil
+}
+
+func (f *goosFile) close() error {
+	return goosErrno(goos.FS.Close(f.h))
+}
+
+// Dirent field offsets — byte-poked (rec may not be aligned for a
+// *Dirent cast, same caveat fs_racccoon.go's dir reader notes).
+const (
+	direntOffIno    = 0
+	direntOffReclen = 16
+	direntOffType   = 18
+	direntOffName   = 20
+)
+
+func goosPutDirent(rec []byte, ino int64, name string, isDir bool) {
+	for i := 0; i < direntSize; i++ {
+		rec[i] = 0
+	}
+	u := uint64(ino)
+	for i := 0; i < 8; i++ {
+		rec[direntOffIno+i] = byte(u >> (8 * i))
+	}
+	rec[direntOffReclen] = byte(direntSize & 0xff)
+	rec[direntOffReclen+1] = byte((direntSize >> 8) & 0xff)
+	if isDir {
+		rec[direntOffType] = DT_DIR
+	} else {
+		rec[direntOffType] = DT_REG
+	}
+	copy(rec[direntOffName:direntSize], name)
+}
+
+func (f *goosFile) readDirent(buf []byte) (int, error) {
+	if f.dents == nil {
+		names, isDir, e := goos.FS.Dirents(f.h)
+		if e != 0 {
+			return 0, goosErrno(e)
+		}
+		if names == nil {
+			names = []string{}
+		}
+		f.dents, f.dentsD = names, isDir
+	}
+	n := 0
+	for f.dpos < len(f.dents) && len(buf) >= direntSize {
+		isDir := f.dpos < len(f.dentsD) && f.dentsD[f.dpos]
+		goosPutDirent(buf[:direntSize], int64(f.dpos+1), f.dents[f.dpos], isDir)
+		buf = buf[direntSize:]
+		n += direntSize
+		f.dpos++
+	}
+	return n, nil
+}
+
+// --- os.Pipe output capture -------------------------------------------
+// os/exec builds an os.Pipe() when Cmd.Stdout/Stderr is not an *os.File
+// (a bytes.Buffer, for Output / CombinedOutput). On racccoon the write
+// end never reaches the child — it's a separate process — so instead
+// StartProcess reads the capID off the write end, goos.Spawn points the
+// child's console at a kernel pipe and drains it, and the read end
+// (goosPipeFile) serves those bytes to os/exec's io.Copy goroutine.
+
+type goosPipeFile struct {
+	defaultFileImpl
+	capID  int
+	isRead bool
+	data   []byte
+	rpos   int
+	got    bool
+}
+
+// PipeGoos backs os.Pipe() on racccoon. nil goos.FS (a vanilla tamago
+// build) keeps os.Pipe unsupported.
+func PipeGoos(fd []int) error {
+	if goos.FS == nil {
+		return ENOSYS
+	}
+	id := goos.CaptureAlloc()
+	if id < 0 {
+		return EMFILE
+	}
+	fd[0] = newFD(&goosPipeFile{capID: id, isRead: true})
+	fd[1] = newFD(&goosPipeFile{capID: id, isRead: false})
+	return nil
+}
+
+func (f *goosPipeFile) read(b []byte) (int, error) {
+	if !f.isRead {
+		return 0, EINVAL
+	}
+	if !f.got {
+		f.data = goos.CaptureData(f.capID)
+		f.got = true
+	}
+	if f.rpos >= len(f.data) {
+		return 0, nil // EOF (os.File has ZeroReadIsEOF)
+	}
+	n := copy(b, f.data[f.rpos:])
+	f.rpos += n
+	return n, nil
+}
+
+// The write end is a placeholder: the child writes to its own console,
+// not through this fd. Accept and discard so os/exec's bookkeeping
+// (which closes it right after StartProcess) doesn't error.
+func (f *goosPipeFile) write(b []byte) (int, error) { return len(b), nil }
+
+func (f *goosPipeFile) stat(st *Stat_t) error {
+	*st = Stat_t{Mode: S_IFIFO | 0600, Nlink: 1}
+	return nil
+}
+
+func (f *goosPipeFile) close() error {
+	if f.isRead {
+		goos.CaptureFree(f.capID)
+	}
+	return nil
+}
