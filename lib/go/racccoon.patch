@@ -58,6 +58,41 @@ var (
 	Nanotime = sys_clock_gettime
 )
 
+// FS, when set by a GOOSPKG provider (or any imported package), replaces
+// syscall's in-memory filesystem (syscall/fs_tamago.go) with a
+// host-backed one, so package os operates on real, persistent storage.
+// nil (the default) keeps the in-memory fs. See docs/go-port-plan.md in
+// the racccoon tree.
+var FS FSHook
+
+// Args, when set by a GOOSPKG provider, returns the process argument
+// vector for os.Args (the runtime's goargs() otherwise hardcodes
+// {"tamago"}). Keep in sync with go/goos/racccoon_user.go.
+var Args func() []string
+
+// FSHook is the contract a host filesystem backend implements. Handles
+// are opaque tokens the backend hands back from Open and gets back on
+// every subsequent call; the syscall layer never inspects them. All
+// paths are already absolute (package os / syscall resolves cwd first
+// via Getwd).
+type FSHook interface {
+	Open(path string, flags int, perm uint32) (h uintptr, isDir bool, size int64, err error)
+	Close(h uintptr) error
+	Pread(h uintptr, b []byte, off int64) (int, error)
+	Pwrite(h uintptr, b []byte, off int64) (int, error)
+	Fstat(h uintptr) (size int64, isDir bool, err error)
+	// Dirents returns the full listing of the directory h refers to:
+	// entry names and, per name, whether it is itself a directory.
+	Dirents(h uintptr) (names []string, isDir []bool, err error)
+	Stat(path string) (size int64, isDir bool, err error)
+	Mkdir(path string, perm uint32) error
+	Remove(path string, dir bool) error
+	Rename(from, to string) error
+	Truncate(path string, size int64) error
+	Getwd() (string, error)
+	Chdir(path string) error
+}
+
