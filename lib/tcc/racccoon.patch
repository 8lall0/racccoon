+/* racccoon: lay the output out like src/kernel.ld instead of tcc's default.
+   Only the freestanding static-kernel case (no dynamic / TLS / interp /
+   relro). .text.boot lands at exactly kernel_image_base with the ELF
+   headers preceding it in the file (not mapped there); sections follow in
+   boot / trap / text / RO / RW / bss order; the kernel.ld symbols are
+   defined SHN_ABS. Returns the program-header count. */
+static int tcc_kernel_relayout(TCCState *s1, int *sec_order, struct dyn_inf *d)
+{
+    addr_t base = s1->kernel_image_base;
+    int nb = s1->nb_sections, i, j;
+    int *ord = tcc_malloc(sizeof(int) * nb);
+    int *cls = tcc_malloc(sizeof(int) * nb);
+    addr_t page = 0x1000;
+
+    for (i = 0; i < nb; i++) {
+        Section *s = s1->sections[i];
+        int k;
+        if (i == 0) k = -1;
+        else if (!(s->sh_flags & SHF_ALLOC)) k = 100;
+        else if (!strcmp(s->name, ".text.boot")) k = 0;
+        else if (!strcmp(s->name, ".text.trap")) k = 1;
+        else if (s->sh_flags & SHF_EXECINSTR) k = 2;
+        else if (s->sh_type == SHT_NOBITS) k = 5;
+        else if (s->sh_flags & SHF_WRITE) k = 4;
+        else k = 3;
+        cls[i] = k;
+        ord[i] = i;
+    }
+    /* stable insertion sort of section indices by class (keep [0] first) */
+    for (i = 2; i < nb; i++) {
+        int v = ord[i], kv = cls[v];
+        for (j = i; j > 1 && cls[ord[j - 1]] > kv; j--) ord[j] = ord[j - 1];
+        ord[j] = v;
+    }
+
+    /* one PT_LOAD per run of alloc sections sharing (WRITE|EXEC) flags */
+    int phn = 0, prevfl = -1;
+    for (j = 1; j < nb; j++) {
+        Section *s = s1->sections[ord[j]];
+        if (!(s->sh_flags & SHF_ALLOC) || !s->sh_size) continue;
+        int fl = s->sh_flags & (SHF_WRITE | SHF_EXECINSTR);
+        if (fl != prevfl) { phn++; prevfl = fl; }
+    }
+    ElfW(Phdr) *ph = tcc_mallocz((phn ? phn : 1) * sizeof(ElfW(Phdr)));
+
+    /* file: [Ehdr][Phdrs][Shdrs][pad][section data] — see tcc_output_elf */
+    addr_t hdrs = sizeof(ElfW(Ehdr)) + (addr_t)phn * sizeof(ElfW(Phdr))
+                + (addr_t)nb * sizeof(ElfW(Shdr));
+    addr_t foff = (hdrs + page - 1) & ~(page - 1);
+
+    addr_t dot = base;
+    addr_t bss_s = 0, bss_e = 0; int have_bss = 0;
+    int cur = -1; prevfl = -1;
+
+    for (j = 1; j < nb; j++) {
+        Section *s = s1->sections[ord[j]];
+        addr_t al = s->sh_addralign ? s->sh_addralign : 1;
+        if (!(s->sh_flags & SHF_ALLOC)) {
+            foff = (foff + al - 1) & ~(al - 1);
+            s->sh_offset = foff;
+            if (s->sh_type != SHT_NOBITS) foff += s->sh_size;
+            continue;
+        }
+        if (al < 4) al = 4;
+        int fl = s->sh_flags & (SHF_WRITE | SHF_EXECINSTR);
+        if (fl != prevfl && s->sh_size) {
+            dot = (dot + page - 1) & ~(page - 1);
+            foff = (foff + page - 1) & ~(page - 1);
+            cur++;
+            ph[cur].p_type = PT_LOAD;
+            ph[cur].p_offset = foff;
+            ph[cur].p_vaddr = ph[cur].p_paddr = dot;
+            ph[cur].p_align = page;
+            ph[cur].p_flags = PF_R
+                | ((fl & SHF_WRITE) ? PF_W : 0)
+                | ((fl & SHF_EXECINSTR) ? PF_X : 0);
+            prevfl = fl;
+        }
+        dot = (dot + al - 1) & ~(al - 1);
+        foff = ph[cur].p_offset + (dot - ph[cur].p_vaddr);
+        s->sh_addr = dot;
+        s->sh_offset = foff;
+        if (s->sh_type == SHT_NOBITS) {
+            if (!have_bss) { bss_s = dot; have_bss = 1; }
+            bss_e = dot + s->sh_size;
+        }
+        dot += s->sh_size;
+        if (s->sh_type != SHT_NOBITS) foff += s->sh_size;
+        ph[cur].p_memsz = dot - ph[cur].p_vaddr;
+        if (s->sh_type != SHT_NOBITS)
+            ph[cur].p_filesz = foff - ph[cur].p_offset;
+    }
+    if (!have_bss) bss_s = bss_e = dot;
+
+    /* kernel.ld tail: . = ALIGN(4); . += 128K; __stack_top;
+       . = ALIGN(4096); __free_ram; . += 1792M; __free_ram_end */
+    addr_t t = (bss_e + 3) & ~(addr_t)3;
+    t += 128 * 1024;
+    addr_t stack_top = t;
+    t = (t + 4095) & ~(addr_t)4095;
+    addr_t free_ram = t;
+    addr_t free_ram_end = free_ram + (addr_t)1792 * 1024 * 1024;
+
+    /* src/kernel.c3 declares these as `char[] __bss @export(...)` — real
+       .bss globals in kernel.o, so the linker script value must *override*
+       the object definition (as ld/lld do for a script `sym = .`), not add
+       a second one. Rewrite the existing symtab entry to SHN_ABS + value. */
+    {
+        struct { const char *nm; addr_t v; } ksym[] = {
+            { "__kernel_map_base", base },   { "__kernel_base", base },
+            { "__bss", bss_s },              { "__bss_end", bss_e },
+            { "__stack_top", stack_top },    { "__free_ram", free_ram },
+            { "__free_ram_end", free_ram_end },
+        };
+        for (i = 0; i < (int)(sizeof ksym / sizeof ksym[0]); i++) {
+            int si = find_elf_sym(symtab_section, ksym[i].nm);
+            if (si) {
+                ElfW(Sym) *sy = &((ElfW(Sym) *)symtab_section->data)[si];
+                sy->st_value = ksym[i].v;
+                sy->st_size = 0;
+                sy->st_shndx = SHN_ABS;
+                sy->st_info = ELFW(ST_INFO)(STB_GLOBAL, STT_NOTYPE);
+            } else {
+                set_global_sym(s1, ksym[i].nm, NULL, ksym[i].v);
+            }
+        }
+    }
+
+    d->phnum = phn;
+    d->phdr = ph;
+    d->shnum = nb;
+    for (i = 0; i < nb; i++) sec_order[i] = ord[i];
+
+    tcc_free(ord);
+    tcc_free(cls);
+    return phn;
+}
