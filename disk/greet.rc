#!/bin/rc
# Shell control-flow fixture (docs/roadmap.md §2.5): positional params,
# shell-locals, if/else, for, while, break/continue, command
# substitution (`{...}` / `...`).
echo greet: hello, $# args, first=$1
name=world
echo greet: name is $name
if (test $# -ge 1) {
    echo greet: arg1 = $1
} else {
    echo greet: no arg1
}
for (w in alpha beta gamma) {
    echo greet: word $w
}
i=0
while (test $i -lt 3) {
    echo greet: iter $i
    i=`expr $i + 1`
}
for (n in 1 2 3 4 5) {
    if (test $n -eq 3) break
    if (test $n -eq 1) continue
    echo greet: n=$n
}
count=3
if (test $count -gt 2) echo greet: count over two
echo greet: bye
